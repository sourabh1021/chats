<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New chat</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/new.css">
</head>
<body>
    <div class="New">
        <h1>Write New Chat</h1>
        <form action="/chats" method="post">
            <input type="text" name="from" placeholder="Who are You?"><br><br>
            <input type="text" name="msg" placeholder="write Your Message here.."><br><br>
            <input type="text" name="to" placeholder="add receiver"><br><br>
            <button>Send</button>
        </form>
    </div>
</body>
</html>